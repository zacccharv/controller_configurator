code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 ColorParameter : source_color = vec4(0.980000, 0.774200, 0.859950, 1.000000);
uniform int Item_Count = 10;
uniform vec4 ColorParameter2 : source_color = vec4(0.141600, 0.560107, 0.590000, 1.000000);



void fragment() {
// ColorParameter:16
	vec4 n_out16p0 = ColorParameter;


// Input:5
	vec2 n_out5p0 = UV;


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_in4p2 = vec2(0.00000, 0.00000);
	vec2 n_out4p0 = (n_out5p0 - n_in4p2) * n_in4p1 + n_in4p2;


// VectorDecompose:7
	float n_out7p0 = n_out4p0.x;
	float n_out7p1 = n_out4p0.y;


// IntParameter:14
	int n_out14p0 = Item_Count;


// FloatOp:13
	float n_in13p1 = 0.50000;
	float n_out13p0 = float(n_out14p0) * n_in13p1;


// FloatOp:12
	float n_in12p0 = 1.00000;
	float n_out12p0 = n_in12p0 / n_out13p0;


// FloatOp:8
	float n_out8p0 = mod(n_out7p1, n_out12p0);


// FloatOp:10
	float n_out10p0 = n_out8p0 * n_out13p0;


// FloatFunc:9
	float n_out9p0 = round(n_out10p0);


// ColorOp:15
	vec3 n_out15p0 = vec3(1.0) - (vec3(1.0) - vec3(n_out16p0.xyz)) / (vec3(n_out9p0));


// ColorParameter:18
	vec4 n_out18p0 = ColorParameter2;


// ColorOp:19
	vec3 n_out19p0 = vec3(1.0) - (vec3(1.0) - vec3(n_out9p0)) * (vec3(1.0) - vec3(n_out18p0.xyz));


// ColorOp:20
	vec3 n_out20p0 = min(n_out15p0, n_out19p0);


// Output:0
	COLOR.rgb = n_out20p0;


}
